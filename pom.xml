<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>esq</groupId>
        <artifactId>esq-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>esq.phonemod</groupId>
    <artifactId>phonemod-parent</artifactId>
    <version>2.0.0-alpha.13</version>
    <packaging>pom</packaging>
    <name>Phonemod</name>

    <modules>
        <module>phonemod-api</module>
        <module>phonemod-ui-kit</module>
        <module>phonemod-runtime</module>
    </modules>

    <properties>
        <hytale.install-dir>${project.basedir}/../HytaleServer.jar</hytale.install-dir>
        <hytale.patchline>pre-release</hytale.patchline>
        <junit.version>5.12.2</junit.version>
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- F2 (plan sec.4): default run excludes @Tag("contract") (the 60
                     skeleton tests); the `contract` profile flips to running ONLY
                     them. Same fork/argLine as phonemod-runtime so HytaleLogManager
                     installs before java.util.logging initializes. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                        <argLine>-Djava.util.logging.manager=com.hypixel.hytale.logger.backend.HytaleLogManager</argLine>
                        <!-- surefire 3.0.0-M5 fallback (plan sec.4): the positive
                             `groups` selector, honoured reliably by M5, is used in
                             both the default run and the `contract` profile below,
                             instead of relying on excludedGroups override merge. -->
                        <groups>!contract</groups>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>contract</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <forkCount>1</forkCount>
                            <reuseForks>true</reuseForks>
                            <argLine>-Djava.util.logging.manager=com.hypixel.hytale.logger.backend.HytaleLogManager</argLine>
                            <groups>contract</groups>
                            <excludedGroups combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
