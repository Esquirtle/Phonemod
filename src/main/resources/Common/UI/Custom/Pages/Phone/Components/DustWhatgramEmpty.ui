// Empty-state card shown in #WhatgramContent when the player has no
// conversations yet. Appended by WhatgramApp in place of conversation rows.
// Static content — the app sets nothing on it. Proven constructs only.
$D = "../../DustLib.ui";

Group #WhatgramEmpty {
  FlexWeight: 1;
  LayoutMode: Top;
  Padding: (Full: 24);

  Label #EmptyTitle {
    Anchor: (Height: 24);
    Text: "No conversations yet";
    Style: (FontSize: 14, RenderBold: true, Alignment: Center, TextColor: $D.@DustTextPrimary);
  }
  Label #EmptyHint {
    Anchor: (Height: 20);
    Text: "Start a chat from Contacts.";
    Style: (FontSize: 11, Alignment: Center, TextColor: $D.@DustTextSecondary);
  }
}
