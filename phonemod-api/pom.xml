<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>esq.phonemod</groupId>
        <artifactId>phonemod-parent</artifactId>
        <version>2.0.0-alpha.13</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <groupId>esq.phonemod</groupId>
    <artifactId>phonemod-api</artifactId>
    <name>Phonemod Public API</name>
    <description>Compile-only public API for the Phonemod device platform.</description>
    <properties>
        <hytale.install-dir>${project.basedir}/../../HytaleServer.jar</hytale.install-dir>
    </properties>
    <dependencies>
        <!-- Mark optional so downstream consumers of phonemod-api do not inherit this
             system-scoped dependency. Consumers declare their own hytale-server dep
             with a correct local systemPath. -->
        <dependency>
            <groupId>com.hytale</groupId>
            <artifactId>hytale-server</artifactId>
            <version>LOCAL</version>
            <scope>system</scope>
            <systemPath>${hytale.install-dir}</systemPath>
            <optional>true</optional>
        </dependency>
        <!-- F2 (plan sec.4): JUnit, test scope, for the api/v3 contract tests. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration><forceCreation>true</forceCreation></configuration>
            </plugin>
        </plugins>
    </build>
</project>
